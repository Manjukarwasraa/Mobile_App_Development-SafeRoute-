<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for Firebase Authentication and Firestore -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required for SOS location sharing (Step 6) -->
    <!-- COARSE: approximate location via WiFi/cell — no runtime prompt needed -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- FINE: precise GPS location — runtime permission prompt shown to user -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SafeRoute">

        <!--
            MainActivity: auth router — no UI, just redirects to Login or Dashboard.
            This is the LAUNCHER activity (the one Android starts when the app icon is tapped).
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SafeRoute">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login screen -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.SafeRoute.Auth"
            android:windowSoftInputMode="adjustResize" />

        <!-- Registration screen -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.SafeRoute.Auth"
            android:windowSoftInputMode="adjustResize" />

        <!-- Dashboard (placeholder — Step 4 will flesh this out) -->
        <activity
            android:name=".DashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.SafeRoute" />

        <!-- Emergency Contacts screen -->
        <activity
            android:name=".ContactsActivity"
            android:exported="false"
            android:theme="@style/Theme.SafeRoute"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>